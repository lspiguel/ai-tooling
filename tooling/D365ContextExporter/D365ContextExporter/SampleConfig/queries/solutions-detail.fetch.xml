<fetch version="1.0" output-format="xml-platform" mapping="logical" distinct="false">
  <entity name="solution">
    <attribute name="solutionid" />
    <attribute name="uniquename" />
    <attribute name="friendlyname" />
    <attribute name="description" />
    <attribute name="version" />
    <attribute name="ismanaged" />
    <attribute name="installedon" />
    <attribute name="modifiedon" />
    <link-entity name="publisher" from="publisherid" to="publisherid" link-type="inner" alias="pub">
      <attribute name="friendlyname" alias="publisherfriendlyname" />
      <attribute name="uniquename" alias="publisheruniquename" />
      <attribute name="customizationprefix" alias="publisherprefix" />
    </link-entity>
    <filter type="and">
      <condition attribute="isvisible" operator="eq" value="1" />
      <condition attribute="uniquename" operator="not-in">
        <value>Default</value>
        <value>Active</value>
      </condition>
    </filter>
    <order attribute="friendlyname" descending="false" />
  </entity>
</fetch>
