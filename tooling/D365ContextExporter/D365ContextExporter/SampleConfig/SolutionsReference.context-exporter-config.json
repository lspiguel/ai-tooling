{
  "$schema": "./context-exporter.schema.json",
  "spec": "SolutionsReference",
  "version": "1.0.0",
  "legal": "LEGAL.md",
  "frontMatter": {
    "generatedBy": "D365 CE Context Exporter",
    "purpose": "AI assistant grounding context — full customization reference"
  },
  "transformation": "solutions-reference.sbn",
  "queries": [
    {
      "id": "solutions",
      "type": "fetchxml",
      "source": "solutions-detail.fetch.xml",
      "resultKey": "solutions"
    },
    {
      "id": "entities",
      "type": "webapi",
      "path": "EntityDefinitions?$select=LogicalName,DisplayName,Description,IsActivity,IsCustomEntity,IsManaged,IsIntersect,TableType,DataProviderId&$expand=Attributes($select=LogicalName,DisplayName,AttributeType,AttributeTypeName,RequiredLevel,IsManaged;$filter=IsCustomAttribute eq true and IsManaged eq false and AttributeOf eq null)",
      "resultKey": "entities"
    },
    {
      "id": "relationships-one-to-many",
      "type": "webapi",
      "path": "RelationshipDefinitions/Microsoft.Dynamics.CRM.OneToManyRelationshipMetadata?$select=SchemaName,ReferencedEntity,ReferencingEntity,ReferencingAttribute&$filter=IsCustomRelationship eq true and IsManaged eq false",
      "resultKey": "oneToMany"
    },
    {
      "id": "relationships-many-to-many",
      "type": "webapi",
      "path": "RelationshipDefinitions/Microsoft.Dynamics.CRM.ManyToManyRelationshipMetadata?$select=SchemaName,Entity1LogicalName,Entity2LogicalName,IntersectEntityName&$filter=IsCustomRelationship eq true and IsManaged eq false",
      "resultKey": "manyToMany"
    },
    {
      "id": "project-tables",
      "type": "fetchxml",
      "source": "project-tables.fetch.xml",
      "resultKey": "projectTables"
    },
    {
      "id": "project-forms",
      "type": "fetchxml",
      "source": "project-forms.fetch.xml",
      "resultKey": "forms"
    },
    {
      "id": "project-views",
      "type": "fetchxml",
      "source": "project-views.fetch.xml",
      "resultKey": "views"
    },
    {
      "id": "global-optionsets",
      "type": "webapi",
      "path": "GlobalOptionSetDefinitions",
      "resultKey": "globalOptionSets"
    },
    {
      "id": "plugin-assemblies",
      "type": "fetchxml",
      "source": "plugin-assemblies.fetch.xml",
      "resultKey": "pluginAssemblies"
    },
    {
      "id": "sdk-steps",
      "type": "fetchxml",
      "source": "sdk-steps.fetch.xml",
      "resultKey": "sdkSteps"
    },
    {
      "id": "custom-apis",
      "type": "fetchxml",
      "source": "custom-apis.fetch.xml",
      "resultKey": "customApiRequests"
    },
    {
      "id": "custom-api-responses",
      "type": "fetchxml",
      "source": "custom-api-responses.fetch.xml",
      "resultKey": "customApiResponses"
    },
    {
      "id": "workflows",
      "type": "fetchxml",
      "source": "workflows.fetch.xml",
      "resultKey": "workflows"
    },
    {
      "id": "business-process-flows",
      "type": "fetchxml",
      "source": "business-process-flows.fetch.xml",
      "resultKey": "businessProcessFlows"
    },
    {
      "id": "bpf-stages",
      "type": "fetchxml",
      "source": "bpf-stages.fetch.xml",
      "resultKey": "bpfStages"
    },
    {
      "id": "app-modules",
      "type": "fetchxml",
      "source": "app-modules.fetch.xml",
      "resultKey": "appModules"
    },
    {
      "id": "env-vars",
      "type": "fetchxml",
      "source": "env-vars.fetch.xml",
      "resultKey": "envVars"
    },
    {
      "id": "security-role-names",
      "type": "fetchxml",
      "source": "security-role-names.fetch.xml",
      "resultKey": "securityRoles"
    }
  ]
}
