{
  "$schema": "./context-exporter.schema.json",
  "spec": "FormsAndViews",
  "version": "1.0.0",
  "legal": "LEGAL.md",
  "frontMatter": {
    "generatedBy": "D365 CE Context Exporter",
    "purpose": "AI assistant grounding context — forms and views"
  },
  "transformation": "forms-and-views.sbn",
  "queries": [
    {
      "id": "entities",
      "type": "webapi",
      "path": "EntityDefinitions?$select=LogicalName,DisplayName",
      "resultKey": "entities"
    },
    {
      "id": "project-forms",
      "type": "fetchxml",
      "source": "project-forms.fetch.xml",
      "resultKey": "forms"
    },
    {
      "id": "project-views",
      "type": "fetchxml",
      "source": "project-views.fetch.xml",
      "resultKey": "views"
    }
  ]
}
