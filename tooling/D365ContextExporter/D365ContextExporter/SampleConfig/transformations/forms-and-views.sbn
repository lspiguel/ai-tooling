---
{{ for pair in _meta.frontMatter }}
{{ pair.key }}: {{ pair.value -}}
{{ end }}
exportedAt: {{ _meta.exportedAtUtc | date.to_string "%Y-%m-%dT%H:%M:%SZ" }}
environment: {{ _meta.environment.url }}

---

# Forms and Views — {{ _meta.environment.orgName }}

> Generated by {{ _meta.frontMatter.generatedBy }} on {{ _meta.exportedAtUtc }}.
> Scope: forms and views the project created (unmanaged) or customized (in a project solution). Main, quick view, quick create and card forms; public, Advanced Find, associated, Quick Find and lookup views.

{{-
  # systemform.type — https://learn.microsoft.com/power-apps/developer/data-platform/reference/entities/systemform
  form_type_labels = {}
  form_type_labels["2"] = "Main"
  form_type_labels["6"] = "Quick View"
  form_type_labels["7"] = "Quick Create"
  form_type_labels["11"] = "Card"

  # savedquery.querytype — SavedQueryQueryType
  view_type_labels = {}
  view_type_labels["0"] = "Public"
  view_type_labels["1"] = "Advanced Find"
  view_type_labels["2"] = "Associated"
  view_type_labels["4"] = "Quick Find"
  view_type_labels["64"] = "Lookup"

  forms_by_table = {}
  for g in forms | group_by_key "objecttypecode"
    if g.key != null
      forms_by_table[g.key] = g.items
    end
  end

  views_by_table = {}
  for g in views | group_by_key "returnedtypecode"
    if g.key != null
      views_by_table[g.key] = g.items
    end
  end
-}}

{{ for entity in entities | array.sort "LogicalName" -}}
{{ ent_forms = forms_by_table[entity.LogicalName] -}}
{{ ent_views = views_by_table[entity.LogicalName] -}}
{{ if ent_forms == null && ent_views == null -}}{{ continue -}}{{ end -}}
## {{ entity.LogicalName }}

**Display Name:** {{ entity.DisplayName | display_label entity.LogicalName }}

{{ if ent_forms != null -}}
### Forms

| Name | Type | Default | Managed |
|------|------|---------|---------|
{{ for form in ent_forms | array.sort "name" -}}
| {{ form.name }} | {{ form_type_labels["" + form.type] ?? form.type }} | {{ if form.isdefault }}✓{{ end }} | {{ if form.ismanaged }}Yes{{ else }}No{{ end }} |
{{ end -}}
{{ end }}
{{ if ent_views != null -}}
### Views

| Name | Type | Default | Managed |
|------|------|---------|---------|
{{ for view in ent_views | array.sort "name" -}}
| {{ view.name }} | {{ view_type_labels["" + view.querytype] ?? view.querytype }} | {{ if view.isdefault }}✓{{ end }} | {{ if view.ismanaged }}Yes{{ else }}No{{ end }} |
{{ end -}}
{{ end }}

{{ end }}
