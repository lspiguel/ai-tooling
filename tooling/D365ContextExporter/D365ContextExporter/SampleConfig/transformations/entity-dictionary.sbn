{{ for pair in _meta.frontMatter }}
{{ pair.key }}: {{ pair.value -}}
{{ end }}
exportedAt: {{ _meta.exportedAtUtc | date.to_string "%Y-%m-%dT%H:%M:%SZ" }}
environment: {{ _meta.environment.url }}

---

# Entity Dictionary — {{ _meta.environment.orgName }}

> Generated by {{ _meta.frontMatter.generatedBy }} on {{ _meta.exportedAtUtc }}.
> Scope: tables the project created (unmanaged) or customized (unmanaged custom columns, or a component of a project solution). Every column of those tables is listed except the name and yomi-name companions of lookups and choices, and currency base columns. **Custom** marks columns that are not part of the table as shipped; **Project** marks unmanaged ones.

{{-
  project_table_ids = {}
  for c in projectTables
    project_table_ids[c.objectid] = true
  end

  func column_type(attr)
    $type_name = attr.AttributeTypeName != null ? attr.AttributeTypeName.Value : null
    if $type_name != null && $type_name != ""
      ret $type_name | string.remove_last "Type"
    end
    ret attr.AttributeType ?? "—"
  end
-}}

{{ for entity in entityAttributes | array.sort "LogicalName" }}
{{-
  if entity.IsIntersect
    continue
  end
  has_project_columns = false
  for a in (entity.Attributes ?? [])
    if a.IsCustomAttribute && !a.IsManaged
      has_project_columns = true
      break
    end
  end
  if entity.IsManaged && !has_project_columns && project_table_ids[entity.MetadataId] == null
    continue
  end
-}}
## {{ entity.LogicalName }}

**Display Name:** {{ display_label entity.DisplayName entity.LogicalName }}
**Primary ID:** `{{ entity.PrimaryIdAttribute ?? "—" }}`
**Primary Name:** `{{ entity.PrimaryNameAttribute ?? "—" }}`
**Ownership:** {{ entity.OwnershipType ?? "—" }}
**Custom table:** {{ if entity.IsCustomEntity }}Yes{{ else }}No{{ end }} · **Managed:** {{ if entity.IsManaged }}Yes{{ else }}No{{ end }}

### Columns

| Schema Name | Display Name | Type | Required | Custom | Project |
|-------------|--------------|------|----------|--------|---------|
{{ for attr in (entity.Attributes ?? []) | array.sort "LogicalName" -}}
{{ if attr.AttributeType == "Money" && (attr.LogicalName | string.ends_with "_base") }}{{ continue }}{{ end -}}
| `{{ attr.LogicalName }}` | {{ display_label attr.DisplayName "—" }} | {{ column_type attr }} | {{ attr.RequiredLevel | req_indicator }} | {{ if attr.IsCustomAttribute }}✓{{ end }} | {{ if !attr.IsManaged }}✓{{ end }} |
{{ end }}
