---
{{ for pair in _meta.frontMatter }}
{{ pair.key }}: {{ pair.value -}}
{{ end }}
exportedAt: {{ _meta.exportedAtUtc | date.to_string "%Y-%m-%dT%H:%M:%SZ" }}
environment: {{ _meta.environment.url }}

---

# Security Model — {{ _meta.environment.orgName }}

> Scope: unmanaged roles in the root business unit that are not based on a Microsoft role template — the roles the project created. Each role is copied to every business unit; the copies hold the same privileges and are not listed.
> Depth: User, Business Unit, Parent: Child Business Units, Organization.

{{ for role_group in securityRoles | group_by_key "name" }}
## {{ role_group.key | string.strip }}

{{
  privs = []
  for p in role_group.items
    if p["priv.name"] != null && p["priv.name"] != ""
      privs = privs | array.add p
    end
  end
-}}
{{ if privs.size > 0 }}
| Privilege | Depth |
|-----------|-------|
{{ for p in privs | array.sort "priv.name" -}}
| {{ p["priv.name"] }} | {{ p["rp.privilegedepthmask"] | priv_depth }} |
{{ end -}}
{{ else }}
_No privileges._
{{ end -}}
{{ end }}
