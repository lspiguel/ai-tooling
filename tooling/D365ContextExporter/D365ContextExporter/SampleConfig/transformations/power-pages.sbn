### Multistep forms
{{ for m in mforms | array.sort "name" }}
{{-
  # Steps in order: from the start step along Next Step; steps reached only through conditions follow.
  steps_by_id = {}
  for s in steps
    if s.c.webform == m.id
      steps_by_id[s.id] = s
    end
  end
  ordered = []
  seen = {}
  cur = m.c.startstep
  guard = 0
  while cur != null && cur != "" && seen[cur] == null && guard < 100
    seen[cur] = true
    if steps_by_id[cur] != null
      ordered = ordered | array.add steps_by_id[cur]
      cur = steps_by_id[cur].c.nextstep
    else
      cur = null
    end
    guard = guard + 1
  end
  for s in steps
    if s.c.webform == m.id && seen[s.id] == null
      ordered = ordered | array.add s
    end
  end
  m_pages = hosted_by[m.id] ?? []
-}}

#### {{ m.name }}

On pages: {{ m_pages.size > 0 ? (m_pages | array.sort | array.join ", ") : "—" }} · Authentication required: {{ m.c.authenticationrequired ? "Yes" : "No" }} · Edit existing record: {{ m.c.editexistingrecordpermitted ? "Yes" : "No" }} · Multiple records per user: {{ m.c.multiplerecordsperuserpermitted ? "Yes" : "No" }}

| # | Step | Type | Table | Form | Mode | Custom JavaScript |
|---|---|---|---|---|---|---|
{{ for s in ordered -}}
| {{ for.index + 1 }} | {{ cell s.name }} | {{ step_labels["" + s.c.type] ?? "—" }} | {{ s.c.targetentitylogicalname != null ? "`" + s.c.targetentitylogicalname + "`" : "—" }} | {{ cell (s.c.formname ?? "—") }}{{ if has_text s.c.tabname }} (tab {{ cell s.c.tabname }}){{ end }} | {{ mode_labels["" + s.c.mode] ?? "—" }} | {{ code_size s.c.registerstartupscript }} |
{{ end -}}
{{ end }}
