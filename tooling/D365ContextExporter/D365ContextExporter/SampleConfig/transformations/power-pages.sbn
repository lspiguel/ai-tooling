| Permission | Table | Access type | Privileges | Web roles | Relationship |
|---|---|---|---|---|---|
{{ for x in perms | array.sort "name" -}}
{{-
  c = x.c
  scope = scope_labels["" + c.scope] ?? ("" + c.scope)
  rel = "—"
  if c.scope == 756150001
    rel = c.contactrelationship ?? "—"
  else if c.scope == 756150002
    rel = c.accountrelationship ?? "—"
  else if c.scope == 756150003
    rel = "Parent: " + (name_of c.parententitypermission) + " via " + (c.parentrelationship ?? "?")
  end
  perm_roles = c.adx_entitypermission_webrole ?? []
-}}
{{- roles_text = perm_roles.size > 0 ? (names_of perm_roles) : (c.scope == 756150003 ? "(through parent)" : "—") -}}
| {{ cell x.name }} | `{{ c.entitylogicalname }}` | {{ scope }} | {{ privileges c }} | {{ cell roles_text }} | {{ cell rel }} |
