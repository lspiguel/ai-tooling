{{ for role in roles | array.sort "name" -}}
{{-
  auto = []
  if role.c.anonymoususersrole; auto = auto | array.add "Anonymous users"; end
  if role.c.authenticatedusersrole; auto = auto | array.add "Authenticated users"; end
  n_perms = 0
  for x in perms; if (x.c.adx_entitypermission_webrole ?? []) | array.contains role.id; n_perms = n_perms + 1; end; end
  n_rules = 0
  for x in rules; if (x.c.adx_webpageaccesscontrolrule_webrole ?? []) | array.contains role.id; n_rules = n_rules + 1; end; end
  n_flows = 0
  for x in flows; if (x.c.adx_CloudFlowConsumer_adx_webrole ?? []) | array.contains role.id; n_flows = n_flows + 1; end; end
-}}
| {{ cell role.name }} | {{ auto.size > 0 ? (auto | array.join ", ") : "— (assigned to contacts)" }} | {{ n_perms }} | {{ n_rules }} | {{ n_flows }} |
