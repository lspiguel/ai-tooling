### Multistep forms
{{ for m in mforms | array.sort "name" }}
{{-
  # Steps in flow order, depth first from the start step: a step's next step follows it, and a
  # condition's "else" branch follows its "then" branch. Steps the start step never reaches come last.
  steps_by_id = {}
  for s in steps
    if s.c.webform == m.id
      steps_by_id[s.id] = s
    end
  end
  ordered = []
  seen = {}
  stack = [m.c.startstep]
  guard = 0
  while stack.size > 0 && guard < 500
    guard = guard + 1
    cur = stack | array.last
    stack = array.remove_at stack (stack.size - 1)
    if cur == null || cur == "" || seen[cur] != null || steps_by_id[cur] == null
      continue
    end
    seen[cur] = true
    s = steps_by_id[cur]
    ordered = ordered | array.add s
    if s.c.type == 100000000 && (has_text s.c.conditiondefaultnextstep)
      stack = stack | array.add s.c.conditiondefaultnextstep
    end
    if has_text s.c.nextstep
      stack = stack | array.add s.c.nextstep
    end
  end
  reached = ordered.size
  for s in steps
    if s.c.webform == m.id && seen[s.id] == null
      ordered = ordered | array.add s
    end
  end
  step_no = {}
  for s in ordered
    step_no[s.id] = for.index + 1
  end
  m_pages = hosted_by[m.id] ?? []
}}
#### {{ m.name }}

On pages: {{ m_pages.size > 0 ? (m_pages | array.sort | array.join ", ") : "—" }} · Authentication required: {{ m.c.authenticationrequired ? "Yes" : "No" }} · Edit existing record: {{ m.c.editexistingrecordpermitted ? "Yes" : "No" }} · Multiple records per user: {{ m.c.multiplerecordsperuserpermitted ? "Yes" : "No" }}{{ if reached + 1 == ordered.size }} · Step {{ ordered.size }} is not reached from the start step{{ else if reached < ordered.size }} · Steps {{ reached + 1 }}–{{ ordered.size }} are not reached from the start step{{ end }}

| # | Step | Type | Table | Form | Mode | Next | Custom JavaScript |
|---|---|---|---|---|---|---|---|
{{ for s in ordered -}}
{{-
  next_id = s.c.nextstep
  next_text = (has_text next_id) ? ("→ " + (step_no[next_id] ?? (name_of next_id))) : "End"
  if s.c.type == 100000000
    else_id = s.c.conditiondefaultnextstep
    next_text = "If `" + (s.c.condition ?? "?") + "` " + next_text + ", else " + ((has_text else_id) ? ("→ " + (step_no[else_id] ?? (name_of else_id))) : "end")
  else if s.c.type == 100000003
    if has_text s.c.redirecturl
      next_text = "Redirect to " + s.c.redirecturl
    else if has_text s.c.redirectwebpage
      next_text = "Redirect to " + (name_of s.c.redirectwebpage)
    else
      next_text = "Redirect (no target set)"
    end
    if (has_text s.c.redirecturlquerystringattribute) && (has_text s.c.redirecturlquerystringattributeparamname)
      next_text = next_text + " with `?" + s.c.redirecturlquerystringattributeparamname + "=` " + s.c.redirecturlquerystringattribute
    end
  end
-}}
| {{ for.index + 1 }} | {{ cell s.name }} | {{ step_labels["" + s.c.type] ?? "—" }} | {{ code_name s.c.targetentitylogicalname }} | {{ cell (s.c.formname ?? "—") }}{{ if has_text s.c.tabname }} (tab {{ cell s.c.tabname }}){{ end }} | {{ mode_labels["" + s.c.mode] ?? "—" }} | {{ cell next_text }} | {{ code_size s.c.registerstartupscript }} |
{{ end -}}
{{ end }}
### Cloud flows

Flows the site calls through the Power Pages connector. Their definitions and triggers are in the PowerAutomateFlows and SolutionsReference exports.

| Cloud flow | Web roles |
|---|---|
{{ for f in flows | array.sort "name" -}}
| {{ cell f.name }} | {{ cell (names_of f.c.adx_CloudFlowConsumer_adx_webrole) }} |
{{ end }}
{{
  webapi = {}
  webapi_tables = []
  for s in settings
    parts = (s.name ?? "") | string.split "/"
    if parts.size == 3 && (parts[0] | string.downcase) == "webapi"
      tbl = parts[1]
      if webapi[tbl] == null
        webapi[tbl] = {}
        webapi_tables = webapi_tables | array.add tbl
      end
      webapi[tbl][parts[2] | string.downcase] = s.c.value
    end
  end
-}}
### Web API

Tables exposed to client-side code through the Power Pages Web API (`Webapi/<table>/enabled` and `Webapi/<table>/fields` site settings). Table permissions still apply.

{{ if webapi_tables.size > 0 -}}
| Table | Enabled | Fields |
|---|---|---|
{{ for tbl in webapi_tables | array.sort -}}
| `{{ tbl }}` | {{ webapi[tbl].enabled ?? "—" }} | {{ cell (webapi[tbl].fields ?? "—") }} |
{{ end -}}
{{ else -}}
_No tables exposed._
{{ end }}
{{
  groups = {}
  group_names = []
  for s in settings
    g = ((s.name ?? "") | string.split "/")[0]
    if groups[g] == null
      groups[g] = []
      group_names = group_names | array.add g
    end
    groups[g] = groups[g] | array.add s
  end
-}}
