#### What each role can do

Tables a member of the role can reach through table permissions granted to the role directly, by table, with each access type once. **Parent** access applies to records related to those the parent permission reaches, named after "via"; child permissions granted only through their parent are in the table below.

{{ for role in roles | array.sort "name" -}}
{{-
  by_table = {}
  for x in perms
    if (x.c.adx_entitypermission_webrole ?? []) | array.contains role.id
      t = x.c.entitylogicalname ?? "?"
      g = scope_labels["" + x.c.scope] ?? ("" + x.c.scope)
      if x.c.scope == 756150003
        parent = perms_by_id[x.c.parententitypermission]
        g = g + " via `" + (parent != null ? (parent.c.entitylogicalname ?? "?") : "?") + "`"
      end
      g = g + ": " + (privileges x.c)
      current = by_table[t] ?? []
      if !(current | array.contains g)
        by_table[t] = current | array.add g
      end
    end
  end
  grants = []
  for t in (object.keys by_table | array.sort)
    grants = grants | array.add ("`" + t + "` " + (by_table[t] | array.sort | array.join "; "))
  end
-}}
- **{{ role.name }}** — {{ grants.size > 0 ? (grants | array.join " · ") : "no table permissions" }}
{{ end }}
