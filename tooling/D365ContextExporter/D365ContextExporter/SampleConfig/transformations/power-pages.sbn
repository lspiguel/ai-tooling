---
{{ for pair in _meta.frontMatter }}
{{ pair.key }}: {{ pair.value -}}
{{ end }}
exportedAt: {{ _meta.exportedAtUtc | date.to_string "%Y-%m-%dT%H:%M:%SZ" }}
environment: {{ _meta.environment.url }}

---

# Power Pages — {{ _meta.environment.orgName }}

> Active Power Pages sites on the enhanced data model (`powerpagesite` / `powerpagecomponent`), and their active components. For each site: what visitors see (the page map and which forms and lists each page hosts), who can do what (web roles, table permissions, page access rules), and how it is built (forms, multistep forms, cloud flows, Web API exposure, site settings, templates and navigation).
> Not included: sites on the standard data model (`adx_` tables), page HTML, web template source and custom JavaScript (only its presence and size), and the values of site settings whose names suggest a secret — those values are never read from Dataverse.

{{
  # powerpagecomponent.powerpagecomponenttype
  # https://learn.microsoft.com/power-apps/developer/data-platform/reference/entities/powerpagecomponent
  type_labels = {}
  type_labels["1"] = "Publishing State"
  type_labels["2"] = "Web Page"
  type_labels["3"] = "Web File"
  type_labels["4"] = "Web Link Set"
  type_labels["5"] = "Web Link"
  type_labels["6"] = "Page Template"
  type_labels["7"] = "Content Snippet"
  type_labels["8"] = "Web Template"
  type_labels["9"] = "Site Setting"
  type_labels["10"] = "Web Page Access Control Rule"
  type_labels["11"] = "Web Role"
  type_labels["13"] = "Site Marker"
  type_labels["15"] = "Basic Form"
  type_labels["17"] = "List"
  type_labels["18"] = "Table Permission"
  type_labels["19"] = "Multistep Form"
  type_labels["20"] = "Multistep Form Step"
  type_labels["30"] = "Redirect"
  type_labels["33"] = "Cloud Flow"

  # Table permission access type (mspp_entitypermission.mspp_scope)
  scope_labels = {}
  scope_labels["756150000"] = "Global"
  scope_labels["756150001"] = "Contact"
  scope_labels["756150002"] = "Account"
  scope_labels["756150003"] = "Parent"
  scope_labels["756150004"] = "Self"
  scope_labels["756150005"] = "Custom"

  # Basic form and step mode (mspp_entityform.mspp_mode)
  mode_labels = {}
  mode_labels["100000000"] = "Insert"
  mode_labels["100000001"] = "Edit"
  mode_labels["100000002"] = "Read only"

  # Multistep form step type (mspp_webformstep.mspp_type)
  step_labels = {}
  step_labels["100000000"] = "Condition"
  step_labels["100000001"] = "Load form"
  step_labels["100000002"] = "Load tab"
  step_labels["100000003"] = "Redirect"
  step_labels["100000004"] = "Load user control"

  # Page template type (mspp_pagetemplate.mspp_type)
  template_labels = {}
  template_labels["756150000"] = "Rewrite"
  template_labels["756150001"] = "Web template"

  names = {}
  comps = []
  for r in ppComponents
    item = {}
    item.id = r.powerpagecomponentid ?? r._id
    item.name = r.name ?? ""
    item.type = r.powerpagecomponenttype
    item.site = r.powerpagesiteid != null ? r.powerpagesiteid.id : ""
    item.lang = r.powerpagesitelanguageid != null ? r.powerpagesitelanguageid.name : null
    item.c = (r.content | parse_json) ?? {}
    names[item.id] = item.name
    comps = comps | array.add item
  end

  # Web templates, web files and sensitive site settings: names only.
  name_only = []
  for r in ppComponentNames
    item = {}
    item.id = r.powerpagecomponentid ?? r._id
    item.name = r.name ?? ""
    item.type = r.powerpagecomponenttype
    item.site = r.powerpagesiteid != null ? r.powerpagesiteid.id : ""
    names[item.id] = item.name
    name_only = name_only | array.add item
  end

  func cell(text)
    if text == null
      ret ""
    end
    ret ("" + text) | string.replace "|" "\\|" | string.replace "\r" "" | string.replace "\n" " "
  end

  func name_of(id)
    if id == null || id == ""
      ret "—"
    end
    ret names[id] ?? "(not found)"
  end

  func names_of(ids)
    if ids == null || ids.size == 0
      ret "—"
    end
    $parts = []
    for one_id in ids
      $parts = $parts | array.add (name_of one_id)
    end
    ret $parts | array.sort | array.join ", "
  end

  func has_text(value)
    ret value != null && ("" + value | string.strip) != ""
  end

  func code_size(value)
    if !(has_text value)
      ret "—"
    end
    ret "Yes (" + (("" + value) | string.split "\n").size + " lines)"
  end

  func sensitive(name)
    $n = ("" + name) | string.downcase
    ret ($n | string.contains "secret") || ($n | string.contains "password") || ($n | string.contains "key") || ($n | string.contains "token") || ($n | string.contains "credential") || ($n | string.contains "connectionstring") || ($n | string.contains "certificate")
  end

  # URL path of a root web page, from its partial URL and its parents' (home is "/").
  func page_path(page)
    $segments = []
    $cur = page
    $guard = 0
    while $cur != null && $guard < 30
      $pu = $cur.c.partialurl ?? ""
      if $pu != "" && $pu != "/"
        $segments = $segments | array.insert_at 0 $pu
      end
      $parent = $cur.c.parentpageid
      $cur = ($parent != null && $parent != "") ? roots_by_id[$parent] : null
      $guard = $guard + 1
    end
    ret "/" + ($segments | array.join "/")
  end

  func privileges(c)
    $p = []
    if c.create; $p = $p | array.add "Create"; end
    if c.read; $p = $p | array.add "Read"; end
    if c.write; $p = $p | array.add "Write"; end
    if c.delete; $p = $p | array.add "Delete"; end
    if c.append; $p = $p | array.add "Append"; end
    if c.appendto; $p = $p | array.add "Append To"; end
    ret $p.size > 0 ? ($p | array.join ", ") : "None"
  end
-}}
{{ if ppSites.size == 0 -}}
_No active Power Pages sites on the enhanced data model._
{{ end -}}
{{ for site in ppSites | array.sort "name" }}
{{-
  sid = site.powerpagesiteid ?? site._id
  roots = []
  content_pages = []
  states = []
  roles = []
  perms = []
  rules = []
  bforms = []
  lists = []
  mforms = []
  steps = []
  flows = []
  settings = []
  ptemplates = []
  snippets = []
  markers = []
  linksets = []
  links = []
  redirects = []
  for x in comps
    if x.site != sid
      continue
    end
    case x.type
      when 1
        states = states | array.add x
      when 2
        if x.c.isroot
          roots = roots | array.add x
        else
          content_pages = content_pages | array.add x
        end
      when 4
        linksets = linksets | array.add x
      when 5
        links = links | array.add x
      when 6
        ptemplates = ptemplates | array.add x
      when 7
        snippets = snippets | array.add x
      when 9
        settings = settings | array.add x
      when 10
        rules = rules | array.add x
      when 11
        roles = roles | array.add x
      when 13
        markers = markers | array.add x
      when 15
        bforms = bforms | array.add x
      when 17
        lists = lists | array.add x
      when 18
        perms = perms | array.add x
      when 19
        mforms = mforms | array.add x
      when 20
        steps = steps | array.add x
      when 30
        redirects = redirects | array.add x
      when 33
        flows = flows | array.add x
    end
  end
  webtemplates = []
  webfiles = []
  secret_settings = []
  for x in name_only
    if x.site != sid
      continue
    end
    case x.type
      when 8
        webtemplates = webtemplates | array.add x
      when 3
        webfiles = webfiles | array.add x
      when 9
        secret_settings = secret_settings | array.add x
    end
  end

  roots_by_id = {}
  for p in roots
    roots_by_id[p.id] = p
  end
  content_by_root = {}
  for p in content_pages
    rid = p.c.rootwebpageid
    if rid != null
      content_by_root[rid] = (content_by_root[rid] ?? []) | array.add p
    end
  end

  # Which pages host each form, list and multistep form (set on the root or a content page).
  hosted_by = {}
  for p in roots
    for v in [p] | array.concat (content_by_root[p.id] ?? [])
      for target in [v.c.entityform, v.c.entitylist, v.c.webform]
        if target != null && target != ""
          current = hosted_by[target] ?? []
          if !(current | array.contains p.name)
            hosted_by[target] = current | array.add p.name
          end
        end
      end
    end
  end

  rules_by_page = {}
  for r in rules
    pid = r.c.webpageid
    if pid != null
      rules_by_page[pid] = (rules_by_page[pid] ?? []) | array.add r
    end
  end

  page_rows = []
  for p in roots
    row = {}
    row.path = page_path p
    row.page = p
    page_rows = page_rows | array.add row
  end
  page_rows = page_rows | array.sort "path"
-}}
## Site: {{ site.name }}

| Domain | Data model | Pages | Web roles | Table permissions | Basic forms | Lists | Multistep forms | Site settings |
|---|---|---|---|---|---|---|---|---|
| {{ site.primarydomainname ?? "—" }} | {{ site.datamodelversion ?? "—" }} | {{ roots.size }} | {{ roles.size }} | {{ perms.size }} | {{ bforms.size }} | {{ lists.size }} | {{ mforms.size }} | {{ settings.size + secret_settings.size }} |

### Page map

One row per page, ordered by URL. **Hosts** is the basic form, list or multistep form shown on the page; **Access** lists its page access control rules. **Custom code** marks pages with their own JavaScript or CSS.

| URL | Page | Template | State | In sitemap | Hosts | Access | Custom code | Languages |
|---|---|---|---|---|---|---|---|---|
{{ for row in page_rows -}}
{{-
  p = row.page
  variants = content_by_root[p.id] ?? []
  hosts = []
  code = []
  langs = []
  for v in [p] | array.concat variants
    if v.c.entityform != null && v.c.entityform != ""
      hosts = hosts | array.add ("Basic form: " + (name_of v.c.entityform))
    end
    if v.c.entitylist != null && v.c.entitylist != ""
      hosts = hosts | array.add ("List: " + (name_of v.c.entitylist))
    end
    if v.c.webform != null && v.c.webform != ""
      hosts = hosts | array.add ("Multistep form: " + (name_of v.c.webform))
    end
    if (has_text v.c.customjavascript) && !(code | array.contains "JS")
      code = code | array.add "JS"
    end
    if (has_text v.c.customcss) && !(code | array.contains "CSS")
      code = code | array.add "CSS"
    end
    if v.lang != null && !(langs | array.contains v.lang)
      langs = langs | array.add v.lang
    end
  end
  access = []
  for r in rules_by_page[p.id] ?? []
    access = access | array.add ((r.c.right == 2 ? "Restrict read" : "Grant change") + " (" + (names_of r.c.adx_webpageaccesscontrolrule_webrole) + ")")
  end
-}}
| `{{ row.path }}` | {{ cell p.name }} | {{ cell (name_of p.c.pagetemplateid) }} | {{ name_of p.c.publishingstateid }} | {{ p.c.hiddenfromsitemap ? "Hidden" : "Yes" }} | {{ cell (hosts | array.uniq | array.join "; ") }} | {{ cell (access | array.join "; ") }} | {{ code | array.join ", " }} | {{ cell (langs | array.join ", ") }} |
{{ end }}
