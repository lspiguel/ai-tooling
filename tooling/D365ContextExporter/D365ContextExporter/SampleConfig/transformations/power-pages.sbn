### Navigation

{{ for set in linksets | array.sort "name" -}}
{{-
  set_links = []
  for l in links
    if l.c.weblinksetid == set.id
      set_links = set_links | array.add ((l.name ?? "") + ((l.c.pageid != null && l.c.pageid != "") ? " → " + (name_of l.c.pageid) : ((has_text l.c.externalurl) ? " → " + l.c.externalurl : "")))
    end
  end
-}}
