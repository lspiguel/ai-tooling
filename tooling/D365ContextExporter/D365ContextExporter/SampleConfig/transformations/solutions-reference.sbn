# {{ _meta.environment.orgName }} D365CE Customization Reference

**Platform:** Dynamics 365 Customer Engagement

> Scope: what the project built or customized. A table is included when it is unmanaged, has unmanaged custom columns, has forms or views the project created or customized, or is a component of a project solution (visible, unmanaged, other than Default and Active). Components installed by first-party or ISV managed solutions and left as shipped are left out.

{{
  # Lookups built once, so each table does not scan every form and view.
  project_table_ids = {}
  for c in projectTables
    project_table_ids[c.objectid] = true
  end

  forms_by_table = {}
  for g in forms | group_by_key "objecttypecode"
    if g.key != null
      forms_by_table[g.key] = g.items
    end
  end

  views_by_table = {}
  for g in views | group_by_key "returnedtypecode"
    if g.key != null
      views_by_table[g.key] = g.items
    end
  end

  form_type_labels = {}
  form_type_labels["2"] = "main"
  form_type_labels["6"] = "quick view"
  form_type_labels["7"] = "quick create"
  form_type_labels["11"] = "card"

  view_type_labels = {}
  view_type_labels["0"] = "public"
  view_type_labels["1"] = "advanced find"
  view_type_labels["2"] = "associated"
  view_type_labels["4"] = "quick find"
  view_type_labels["64"] = "lookup"

  custom_tables = []
  customized_tables = []
  # Managed tables in a project solution with no project columns, forms or views to show
  # (in the solution for a relationship, a ribbon or as a dependency): listed by name only.
  solution_only_tables = []
  virtual_tables = []
  for e in entities | array.sort "LogicalName"
    if e.IsIntersect
      continue
    end
    attrs = e.Attributes ?? []
    has_columns = false
    for a in attrs
      if !(a.AttributeType == "Money" && (a.LogicalName | string.ends_with "_base"))
        has_columns = true
        break
      end
    end
    has_content = has_columns || forms_by_table[e.LogicalName] != null || views_by_table[e.LogicalName] != null
    customized = has_content || project_table_ids[e.MetadataId] != null
    is_virtual = e.TableType == "Virtual" || (e.TableType != "Elastic" && e.DataProviderId != null && e.DataProviderId != "00000000-0000-0000-0000-000000000000")
    if is_virtual && (!e.IsManaged || customized)
      virtual_tables = virtual_tables | array.add e
    else if !e.IsManaged
      custom_tables = custom_tables | array.add e
    else if has_content
      customized_tables = customized_tables | array.add e
    else if customized
      solution_only_tables = solution_only_tables | array.add e.LogicalName
    end
  end

  project_solutions = []
  for sol in solutions | array.sort "friendlyname"
    if !sol.ismanaged
      project_solutions = project_solutions | array.add sol
    end
  end
-}}

