## Business Process Flows

{{
  bpf_stage_map = {}
  for stage in bpfStages
    pid = stage.processid
    if pid != null
      pid_id = pid.id ?? pid
      if bpf_stage_map[pid_id] == null
        bpf_stage_map[pid_id] = []
      end
      bpf_stage_map[pid_id] = bpf_stage_map[pid_id] | array.add stage
    end
  end
-}}
{{ for bpf in businessProcessFlows | array.sort "name" }}
{{- 
  bpf_id = bpf.workflowid ?? bpf._id
  # A process can hold several stage records with the same name and table; list each stage once.
  stages = []
  seen_stages = {}
  for stage in bpf_stage_map[bpf_id] ?? []
    stage_key = stage.stagename + "|" + (stage.primaryentitytypecode ?? "")
    if seen_stages[stage_key] == null
      seen_stages[stage_key] = true
      stages = stages | array.add stage
    end
  end
-}}
