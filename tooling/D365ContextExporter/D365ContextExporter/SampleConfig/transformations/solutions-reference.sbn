## Field Type Legend

`str`=text, `text`=multiline text, `lkp`=lookup, `opt`=choice, `multiopt`=choices (multi-select), `bool`=yes/no, `int`=whole number, `dec`=decimal, `money`=currency, `dt`=date and time, `img`=image, `file`=file, `pk`=unique identifier
Required: **R**=required, **r**=recommended, `-`=optional

---

{{
func column_type(attr)
  $type_name = attr.AttributeTypeName != null ? attr.AttributeTypeName.Value : null
  if $type_name != null && $type_name != ""
    ret ($type_name | string.remove_last "Type") | attr_type_abbrev
  end
  ret attr.AttributeType | attr_type_abbrev
end

func render_columns(table)
  $cols = []
  for attr in (table.Attributes ?? []) | array.sort "LogicalName"
    if !(attr.AttributeType == "Money" && (attr.LogicalName | string.ends_with "_base"))
      $cols = $cols | array.add attr
    end
  end
  if $cols.size == 0
    ret "_No project columns._\n"
  end
  $out = "| Logical Name | Display Name | Type | Req |\n|---|---|---|---|\n"
  for attr in $cols
    $out = $out + "| " + attr.LogicalName + " | " + (attr.DisplayName | display_label attr.LogicalName) + " | " + column_type(attr) + " | " + (attr.RequiredLevel | req_indicator) + " |\n"
  end
  ret $out
end

func render_forms(table)
  $items = forms_by_table[table.LogicalName]
  if $items == null
    ret "—"
  end
  $parts = []
  for f in $items | array.sort "name"
    $parts = $parts | array.add (f.name + " (" + (form_type_labels["" + f.type] ?? ("" + f.type)) + ")")
  end
  ret $parts | array.join ", "
end

func render_views(table)
  $items = views_by_table[table.LogicalName]
  if $items == null
    ret "—"
  end
  $parts = []
  for v in $items | array.sort "name"
    $label = view_type_labels["" + v.querytype] ?? ("" + v.querytype)
    $parts = $parts | array.add ($label == "public" ? v.name : (v.name + " (" + $label + ")"))
  end
  ret $parts | array.join ", "
end

func render_table(table, heading_suffix)
  $out = "\n### " + table.LogicalName + " — \"" + (table.DisplayName | display_label table.LogicalName) + "\"" + heading_suffix + "\n\n"
  $desc = table.Description | display_label ""
  if $desc != ""
    $out = $out + $desc + "\n\n"
  end
  $out = $out + render_columns(table) + "\n"
  $out = $out + "**Forms:** " + render_forms(table) + "\n"
  $out = $out + "**Views:** " + render_views(table) + "\n"
  ret $out
end
-}}

## Custom Tables

Unmanaged tables — created by the project or an unmanaged partner solution.
{{ for t in custom_tables }}{{ render_table t (t.IsActivity ? " *(custom activity)*" : "") }}{{ end }}

