{
  "$schema": "./context-exporter.schema.json",
  "spec": "EntityDictionary",
  "version": "1.0.0",
  "legal": "LEGAL.md",
  "frontMatter": {
    "generatedBy": "D365 CE Context Exporter",
    "purpose": "AI assistant grounding context — entity dictionary"
  },
  "transformation": "entity-dictionary.sbn",
  "queries": [
    {
      "id": "entity-attributes",
      "type": "webapi",
      "path": "EntityDefinitions?$select=LogicalName,DisplayName,PrimaryIdAttribute,PrimaryNameAttribute,OwnershipType,IsCustomEntity,IsManaged,IsIntersect,TableType,DataProviderId&$expand=Attributes($select=LogicalName,DisplayName,AttributeType,AttributeTypeName,IsCustomAttribute,IsManaged,RequiredLevel;$filter=AttributeOf eq null)",
      "resultKey": "entityAttributes"
    },
    {
      "id": "project-tables",
      "type": "fetchxml",
      "source": "project-tables.fetch.xml",
      "resultKey": "projectTables"
    }
  ]
}
