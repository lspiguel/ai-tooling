<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <!--
    Spikes S1 and S6: the MCP layer inside XrmToolBox, a process-wide singleton host, and the
    one-tab-per-connection registry. Throwaway; deploy only AgentCompanionMcp.XtbHostSpike.dll.
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Lspiguel.Xrm.AgentCompanionMcp.Spikes</RootNamespace>
    <AssemblyName>AgentCompanionMcp.XtbHostSpike</AssemblyName>
    <Version>0.0.1</Version>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\McpLayer\*.cs" Link="McpLayer\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MscrmTools.Xrm.Connection" Version="1.2025.9.64" />
    <PackageReference Include="XrmToolBoxPackage" Version="1.2025.10.74" />
    <!-- Compile against Newtonsoft.Json; at run time XrmToolBox's own copy is used (D3). -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.ComponentModel.Composition" />
  </ItemGroup>
</Project>
